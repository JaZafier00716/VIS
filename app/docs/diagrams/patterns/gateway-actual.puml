@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}
hide empty members

class DocumentService
interface DocumentStorage <<Gateway>> {
  +store(String, Path)
  +retrieve(String, Path)
  +delete(String)
  +exists(String) : boolean
}
class FileDocumentStorage
class "document folder" as R <<file system>>
DocumentService --> DocumentStorage
FileDocumentStorage ..|> DocumentStorage
FileDocumentStorage --> R
@enduml
