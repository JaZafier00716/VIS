  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}
hide empty members

class DocumentService
interface DocumentStorage
class FileDocumentStorage
class InMemoryDocumentStorage <<Service Stub>> {
