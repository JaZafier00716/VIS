@startuml
!include common.iuml
actor Pracovník as W
participant "MenuEditorWindow\n(JavaFX)" as EW
participant "CompareRevisionsWindow\n(JavaFX)" as UI
participant MenuService as MS
participant MenuMapper as MM
participant RevisionComparison as RC
database Oracle as DB

W -> EW : Porovnat revize
EW -> UI : open(ctx, menuId, olderNo, newerNo, owner)\n(zobrazená revize a revize před ní)
UI -> MS : listRevisions(menuId)
MS -> MM : findRevisionHeaders(menuId)
MM -> DB : SELECT menu_revisions
MS --> UI : seznam revizí
UI -> MS : compareRevisions(menuId, olderNo, newerNo)
MS -> MM : findRevision(menuId, min(a, b)),\nfindRevision(menuId, max(a, b))
MM -> DB : SELECT ... (2×)
MS -> RC : new RevisionComparison(older, newer)
RC --> MS : řádky ADDED / REMOVED / CHANGED / UNCHANGED
MS --> UI : porovnání
UI --> W : tabulka s barevným zvýrazněním\na rozdíl celkové ceny
opt pracovník zvolí jiné revize a stiskne Porovnat
  W -> UI : starší a novější revize, Porovnat
  UI -> MS : compareRevisions(menuId, olderNo, newerNo)
  MS --> UI : porovnání
  UI --> W : tabulka s barevným zvýrazněním
end
@enduml
