@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam note {
  BackgroundColor #FFFFE0
  BorderColor #999999
}
hide empty members

class MenuService
class DocumentService
class ProjectService
interface TransactionRunner <<port>> {
  +inTransaction(Supplier<T>) : T
  +inTransaction(Runnable)
}
class Database <<Transaction, Singleton>> {
  +inTransaction(Supplier<T>) : T
  +connection() : Connection
}
MenuService --> TransactionRunner
DocumentService --> TransactionRunner
ProjectService --> TransactionRunner
Database ..|> TransactionRunner
note bottom of Database : commit at the end, rollback on exception,\nnested call joins the running transaction
@enduml
